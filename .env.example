# GA4 Measurement ID (public by nature; still prefer env over hardcoding).
# Leave empty to disable gtag in local builds.
PUBLIC_GA_MEASUREMENT_ID=

# Donation payment page URLs shown in the footer (「支援について」).
# Leave empty to show 「寄付の受付は準備中です。」 instead of the link(s).
PUBLIC_DONATION_ONCE_URL=
PUBLIC_DONATION_MONTHLY_URL=
