---
import { getPublishedPosts, sortPostsByDateDesc } from '../lib/posts';

const sorted = sortPostsByDateDesc(await getPublishedPosts());
// Include the latest published issue (also on `/`), not past-only.
const recentIssues = sorted.slice(0, 6);
// No published issues → no menu (avoids empty-state links to a blank /issues/).
const hasBackIssues = recentIssues.length > 0;

const dateFmt = new Intl.DateTimeFormat('ja-JP', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<header class="site-header">
  <a class="site-header__home" href="/">
    <img
      class="site-header__lockup"
      src="/logo-header.png"
      width="679"
      height="195"
      alt="なべっこ"
      decoding="async"
    />
  </a>

  {
    hasBackIssues && (
      <div class="site-header__menu" data-menu>
        <button
          type="button"
          class="site-header__toggle"
          id="menu-toggle"
          aria-controls="site-menu"
          aria-expanded="false"
          aria-haspopup="true"
          data-menu-toggle
        >
          <span class="site-header__toggle-bars" aria-hidden="true"></span>
          <span class="visually-hidden">メニュー</span>
        </button>

        <div
          class="site-header__panel"
          id="site-menu"
          role="region"
          aria-label="バックナンバー"
          hidden
          data-menu-panel
        >
          <nav aria-label="最近の号">
            <ul class="site-header__list">
              {
                recentIssues.map((post) => (
                  <li>
                    <a href={`/issues/${post.id}/`}>
                      <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>
                        {dateFmt.format(post.data.pubDate)}
                      </time>
                      <span>{post.data.title}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
            <p class="site-header__all">
              <a href="/issues/">バックナンバー一覧</a>
            </p>
          </nav>
        </div>
      </div>
    )
  }
</header>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .site-header {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.85rem var(--page-pad) 0.75rem;
    max-width: 72rem;
    margin: 0 auto;
    border-bottom: 1px solid var(--color-line);
  }

  .site-header__home {
    display: block;
    min-width: 0;
    max-width: min(22rem, calc(100% - 3.5rem));
    line-height: 0;
    text-decoration: none;
  }

  .site-header__lockup {
    display: block;
    width: auto;
    max-width: 100%;
    height: clamp(2.4rem, 7vw, 3.1rem);
  }

  .site-header__home:hover {
    opacity: 0.88;
  }

  .site-header__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-sumi);
    cursor: pointer;
  }

  .site-header__toggle:hover {
    color: var(--color-kaki);
  }

  .site-header__toggle-bars,
  .site-header__toggle-bars::before,
  .site-header__toggle-bars::after {
    display: block;
    width: 1.15rem;
    height: 1px;
    background: currentColor;
  }

  .site-header__toggle-bars {
    position: relative;
  }

  .site-header__toggle-bars::before,
  .site-header__toggle-bars::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .site-header__toggle-bars::before {
    top: -0.35rem;
  }

  .site-header__toggle-bars::after {
    top: 0.35rem;
  }

  .site-header__panel {
    position: absolute;
    top: 100%;
    right: var(--page-pad);
    left: var(--page-pad);
    max-width: 24rem;
    margin-left: auto;
    padding: 1.35rem 1.25rem 1.5rem;
    background: var(--color-paper-raised);
    border-bottom: 1px solid var(--color-line);
    z-index: 20;
  }

  .site-header__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__list a {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0.75rem 1rem;
    padding: 1rem 0;
    border-top: 1px solid var(--color-line);
    color: var(--color-sumi);
    text-decoration: none;
    font-size: 0.92rem;
  }

  .site-header__list li:first-child a {
    border-top: 0;
    padding-top: 0.25rem;
  }

  .site-header__list a:hover span {
    color: var(--color-kaki);
  }

  .site-header__list time {
    font-variant-numeric: tabular-nums;
    color: var(--color-sumi-soft);
  }

  .site-header__all {
    margin: 1.15rem 0 0;
    padding-top: 1.15rem;
    border-top: 1px solid var(--color-line);
    font-size: 0.92rem;
  }

  .site-header__all a {
    color: var(--color-kaki-deep);
    text-decoration: none;
  }

  .site-header__all a:hover {
    color: var(--color-kaki);
  }

  @media (max-width: 520px) {
    .site-header__list a {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>

<script>
  function initMenu() {
    const root = document.querySelector('[data-menu]');
    if (!(root instanceof HTMLElement)) return;
    if (root.dataset.menuReady === 'true') return;
    root.dataset.menuReady = 'true';

    const toggle = root.querySelector('[data-menu-toggle]');
    const panel = root.querySelector('[data-menu-panel]');
    if (!(toggle instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) return;

    const getFocusable = () => panel.querySelectorAll('a[href], button:not([disabled])');

    const setOpen = (open) => {
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      panel.hidden = !open;
      if (open) {
        const first = getFocusable()[0];
        if (first instanceof HTMLElement) first.focus();
      } else {
        toggle.focus();
      }
    };

    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    toggle.addEventListener('click', () => setOpen(!isOpen()));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        event.preventDefault();
        setOpen(false);
      }
    });

    document.addEventListener('click', (event) => {
      if (!isOpen()) return;
      if (event.target instanceof Node && !root.contains(event.target)) {
        setOpen(false);
      }
    });
  }

  initMenu();
  document.addEventListener('astro:page-load', initMenu);
</script>
