---
import {
  getLatestPost,
  getPublishedPosts,
  issueListHref,
  issueListLabel,
  sortPostsByDateDesc,
} from '../lib/posts';

const sorted = sortPostsByDateDesc(await getPublishedPosts());
const latestId = getLatestPost(sorted)?.id;
// Include the latest published issue (menu link stays `/`), not past-only.
const recentIssues = sorted.slice(0, 4);

const dateFmt = new Intl.DateTimeFormat('ja-JP', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<header class="site-header">
  <div class="site-header__bar">
    <a class="site-header__home" href="/">
      <img
        class="site-header__lockup"
        src="/logo-header.png"
        width="679"
        height="195"
        alt="なべっこ"
        decoding="async"
      />
    </a>

    <div class="site-header__menu" data-menu>
      <button
        type="button"
        class="site-header__toggle"
        id="menu-toggle"
        aria-controls="site-menu"
        aria-expanded="false"
        aria-haspopup="true"
        data-menu-toggle
      >
        <svg
          class="site-header__toggle-icon site-header__toggle-icon--open"
          width="18"
          height="14"
          viewBox="0 0 18 14"
          aria-hidden="true"
          focusable="false"
        >
          <path
            fill="currentColor"
            d="M0 1h18v1.5H0V1zm0 5.75h18v1.5H0v-1.5zM0 12.5h18V14H0v-1.5z"></path>
        </svg>
        <svg
          class="site-header__toggle-icon site-header__toggle-icon--close"
          width="14"
          height="14"
          viewBox="0 0 14 14"
          aria-hidden="true"
          focusable="false"
        >
          <path
            fill="currentColor"
            d="M1.1 0 0 1.1 5.9 7 0 12.9 1.1 14 7 8.1 12.9 14 14 12.9 8.1 7 14 1.1 12.9 0 7 5.9 1.1 0z"
          ></path>
        </svg>
        <span class="site-header__toggle-label" data-menu-label>メニュー</span>
      </button>

      <div
        class="site-header__panel"
        id="site-menu"
        role="region"
        aria-label="サイトメニュー"
        hidden
        data-menu-panel
      >
        <nav class="site-header__nav" aria-label="サイトメニュー">
          <section class="site-header__section" aria-labelledby="menu-reading">
            <h2 id="menu-reading" class="site-header__heading">記事</h2>
            {
              recentIssues.length > 0 ? (
                <ul class="site-header__list">
                  {recentIssues.map((post) => (
                    <li>
                      <a href={issueListHref(post.id, latestId)}>
                        <span class="site-header__issue-title">{issueListLabel(post.data)}</span>
                        <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>
                          {dateFmt.format(post.data.pubDate)}
                        </time>
                      </a>
                    </li>
                  ))}
                </ul>
              ) : null
            }
            <p class="site-header__more">
              <a href="/issues/">バックナンバー</a>
            </p>
          </section>

          <section class="site-header__section">
            <a class="site-header__section-link" href="/kouhou/">自治体の広報</a>
          </section>

          <section class="site-header__section">
            <a class="site-header__section-link" href="/events/">イベント</a>
          </section>
        </nav>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 40;
    border-bottom: 1px solid var(--color-line);
    /* Opaque — translucent + backdrop-filter made the overflow menu see-through */
    background-color: var(--color-paper);
  }

  .site-header__bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    max-width: var(--header-max);
    margin: 0 auto;
    padding: 1rem var(--page-pad) 0.95rem;
  }

  .site-header__home {
    display: block;
    min-width: 0;
    max-width: min(26rem, calc(100% - 7.5rem));
    line-height: 0;
    text-decoration: none;
    animation: nabecco-rise 0.65s var(--ease-out) both;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__home {
      animation: none;
    }
  }

  .site-header__lockup {
    display: block;
    width: auto;
    max-width: 100%;
    height: clamp(2.65rem, 7.5vw, 3.45rem);
  }

  .site-header__home:hover {
    opacity: 0.9;
  }

  .site-header__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    padding: 0.4rem 0.2rem;
    border: 0;
    border-bottom: 1px solid transparent;
    background: transparent;
    color: var(--color-sumi);
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition:
      color 0.18s var(--ease-out),
      border-color 0.18s var(--ease-out);
  }

  .site-header__toggle:hover,
  .site-header__toggle[aria-expanded='true'] {
    color: var(--color-kaki-deep);
    border-bottom-color: var(--color-kaki);
  }

  .site-header__toggle-icon {
    display: block;
    flex-shrink: 0;
  }

  .site-header__toggle-icon--close,
  .site-header__toggle[aria-expanded='true'] .site-header__toggle-icon--open {
    display: none;
  }

  .site-header__toggle[aria-expanded='true'] .site-header__toggle-icon--close {
    display: block;
  }

  .site-header__toggle-label {
    line-height: 1.2;
  }

  .site-header__panel {
    position: absolute;
    top: calc(100% + 1px);
    right: var(--page-pad);
    left: auto;
    width: min(22rem, calc(100vw - 2 * var(--page-pad)));
    padding: 1.4rem 1.3rem 1.55rem;
    background-color: var(--color-paper-raised);
    border: 1px solid var(--color-line);
    border-top: var(--spine) solid var(--color-kaki);
    z-index: 50;
    isolation: isolate;
  }

  .site-header__panel[hidden] {
    display: none;
  }

  .site-header__nav {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .site-header__section + .site-header__section {
    padding-top: 1.2rem;
    border-top: 1px solid var(--color-line);
  }

  .site-header__heading {
    margin: 0 0 0.6rem;
    font-family: var(--font-display);
    font-size: 0.84rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--color-sumi-soft);
  }

  .site-header__section-link {
    display: block;
    color: var(--color-sumi);
    font-family: var(--font-body);
    font-size: 0.98rem;
    font-weight: 700;
    text-decoration: none;
  }

  .site-header__section-link:hover {
    color: var(--color-kaki);
  }

  .site-header__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__list a {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.2rem;
    min-width: 0;
    padding: 0.8rem 0;
    border-top: 1px solid var(--color-line);
    color: var(--color-sumi);
    text-decoration: none;
  }

  .site-header__list li:first-child a {
    border-top: 0;
    padding-top: 0.1rem;
  }

  .site-header__issue-title {
    display: block;
    width: 100%;
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1.5;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .site-header__list a:hover .site-header__issue-title {
    color: var(--color-kaki);
  }

  .site-header__list time {
    font-family: var(--font-body);
    font-size: 0.74rem;
    line-height: 1.3;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    color: var(--color-sumi-soft);
  }

  .site-header__more {
    margin: 0.4rem 0 0;
    font-size: 0.9rem;
  }

  .site-header__list + .site-header__more {
    margin-top: 0.5rem;
  }

  .site-header__more a {
    color: var(--color-sumi);
    text-decoration: none;
    border-bottom: 1px solid var(--color-line);
  }

  .site-header__more a:hover {
    color: var(--color-kaki);
    border-bottom-color: var(--color-kaki);
  }
</style>

<script>
  function initMenu() {
    const root = document.querySelector('[data-menu]');
    if (!(root instanceof HTMLElement)) return;
    if (root.dataset.menuReady === 'true') return;
    root.dataset.menuReady = 'true';

    const toggle = root.querySelector('[data-menu-toggle]');
    const panel = root.querySelector('[data-menu-panel]');
    if (!(toggle instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) return;

    const label = toggle.querySelector('[data-menu-label]');
    const getFocusable = () => panel.querySelectorAll('a[href], button:not([disabled])');

    const setOpen = (open) => {
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      panel.hidden = !open;
      if (label instanceof HTMLElement) label.textContent = open ? '閉じる' : 'メニュー';
      if (open) {
        const first = getFocusable()[0];
        if (first instanceof HTMLElement) first.focus();
      } else {
        toggle.focus();
      }
    };

    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    toggle.addEventListener('click', () => setOpen(!isOpen()));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        event.preventDefault();
        setOpen(false);
      }
    });

    document.addEventListener('click', (event) => {
      if (!isOpen()) return;
      if (event.target instanceof Node && !root.contains(event.target)) {
        setOpen(false);
      }
    });
  }

  initMenu();
  document.addEventListener('astro:page-load', initMenu);
</script>
