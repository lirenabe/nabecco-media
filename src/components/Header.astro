---
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const sorted = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
// Latest lives on `/` — menu shows recent past issues only.
const recentPast = sorted.slice(1, 6);

const dateFmt = new Intl.DateTimeFormat('ja-JP', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<header class="site-header">
  <a class="site-header__home" href="/">
    <span class="site-header__qualifier">秋田の週刊情報サイト</span>
    <span class="site-header__brand">なべっこ</span>
  </a>

  <div class="site-header__menu" data-menu>
    <button
      type="button"
      class="site-header__toggle"
      id="menu-toggle"
      aria-controls="site-menu"
      aria-expanded="false"
      aria-haspopup="true"
      data-menu-toggle
    >
      <span class="site-header__toggle-bars" aria-hidden="true"></span>
      <span class="visually-hidden">メニュー</span>
    </button>

    <div
      class="site-header__panel"
      id="site-menu"
      role="region"
      aria-label="バックナンバー"
      hidden
      data-menu-panel
    >
      <nav aria-label="最近のバックナンバー">
        {
          recentPast.length === 0 ? (
            <p class="site-header__empty">過去号はまだありません。</p>
          ) : (
            <ul class="site-header__list">
              {recentPast.map((post) => (
                <li>
                  <a href={`/issues/${post.id}/`}>
                    <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>
                      {dateFmt.format(post.data.pubDate)}
                    </time>
                    <span>{post.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
        <p class="site-header__all">
          <a href="/issues/">バックナンバー一覧</a>
        </p>
      </nav>
    </div>
  </div>
</header>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .site-header {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.1rem var(--page-pad) 0.85rem;
    max-width: 72rem;
    margin: 0 auto;
    border-bottom: 1px solid var(--color-ash);
  }

  .site-header__home {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.55rem;
    min-width: 0;
    color: var(--color-sumi);
    text-decoration: none;
  }

  .site-header__home:hover .site-header__brand {
    color: var(--color-kaki);
  }

  .site-header__qualifier {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-sumi-soft);
  }

  .site-header__brand {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .site-header__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-sumi);
    cursor: pointer;
  }

  .site-header__toggle:hover {
    color: var(--color-kaki);
  }

  .site-header__toggle-bars,
  .site-header__toggle-bars::before,
  .site-header__toggle-bars::after {
    display: block;
    width: 1.15rem;
    height: 1px;
    background: currentColor;
  }

  .site-header__toggle-bars {
    position: relative;
  }

  .site-header__toggle-bars::before,
  .site-header__toggle-bars::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .site-header__toggle-bars::before {
    top: -0.35rem;
  }

  .site-header__toggle-bars::after {
    top: 0.35rem;
  }

  .site-header__panel {
    position: absolute;
    top: 100%;
    right: var(--page-pad);
    left: var(--page-pad);
    max-width: 22rem;
    margin-left: auto;
    padding: 0.85rem 0 1.1rem;
    background: var(--color-paper-raised);
    border-bottom: 1px solid var(--color-ash);
    z-index: 20;
  }

  .site-header__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__list a {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0.75rem;
    padding: 0.65rem 0;
    border-top: 1px solid var(--color-ash);
    color: var(--color-sumi);
    text-decoration: none;
    font-size: 0.92rem;
  }

  .site-header__list li:first-child a {
    border-top: 0;
  }

  .site-header__list a:hover span {
    color: var(--color-kaki);
  }

  .site-header__list time {
    font-variant-numeric: tabular-nums;
    color: var(--color-sumi-soft);
  }

  .site-header__empty {
    margin: 0 0 0.75rem;
    font-size: 0.92rem;
    color: var(--color-sumi-soft);
  }

  .site-header__all {
    margin: 0.75rem 0 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-ash);
    font-size: 0.92rem;
  }

  .site-header__all a {
    color: var(--color-kaki-deep);
    text-decoration: none;
  }

  .site-header__all a:hover {
    color: var(--color-kaki);
  }

  @media (max-width: 520px) {
    .site-header__list a {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>

<script>
  function initMenu() {
    const root = document.querySelector('[data-menu]');
    if (!(root instanceof HTMLElement)) return;
    if (root.dataset.menuReady === 'true') return;
    root.dataset.menuReady = 'true';

    const toggle = root.querySelector('[data-menu-toggle]');
    const panel = root.querySelector('[data-menu-panel]');
    if (!(toggle instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) return;

    const getFocusable = () => panel.querySelectorAll('a[href], button:not([disabled])');

    const setOpen = (open) => {
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      panel.hidden = !open;
      if (open) {
        const first = getFocusable()[0];
        if (first instanceof HTMLElement) first.focus();
      } else {
        toggle.focus();
      }
    };

    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    toggle.addEventListener('click', () => setOpen(!isOpen()));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        event.preventDefault();
        setOpen(false);
      }
    });

    document.addEventListener('click', (event) => {
      if (!isOpen()) return;
      if (event.target instanceof Node && !root.contains(event.target)) {
        setOpen(false);
      }
    });
  }

  initMenu();
  document.addEventListener('astro:page-load', initMenu);
</script>
