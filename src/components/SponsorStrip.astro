---
const tiers = [
  { label: 'プラチナパートナー', note: '未掲出' },
  { label: 'ゴールドサポーター', note: '未掲出' },
  { label: 'シルバー・地域店舗', note: '未掲出' },
];
---

<section class="sponsors" id="sponsors" aria-labelledby="sponsors-heading">
  <h2 id="sponsors-heading">サポーター</h2>
  <p class="sponsors__intro">
    詳細は
    <a href="https://github.com/lirenabe/nabecco-media/blob/main/SPONSORS.md">SPONSORS.md</a>
  </p>
  <ul class="sponsors__list">
    {
      tiers.map((tier) => (
        <li>
          <span class="sponsors__label">{tier.label}</span>
          <span class="sponsors__note">{tier.note}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .sponsors {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 0 var(--page-pad) var(--section-gap);
  }

  .sponsors h2 {
    margin: 0 0 0.5rem;
    font-size: 1.2rem;
  }

  .sponsors__intro {
    margin: 0 0 1.25rem;
    color: var(--color-sumi-soft);
    font-size: 0.95rem;
  }

  .sponsors__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sponsors__list li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    padding: 0.65rem 0;
    border-top: 1px solid var(--color-ash);
    font-size: 0.95rem;
  }

  .sponsors__list li:last-child {
    border-bottom: 1px solid var(--color-ash);
  }

  .sponsors__label {
    color: var(--color-sumi);
  }

  .sponsors__note {
    color: var(--color-sumi-soft);
  }
</style>
