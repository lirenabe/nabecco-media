---
/** Real logos later: `{ name, href?, logoSrc? }[]`. Empty = quiet heading only. */
const sponsors: { name: string; href?: string; logoSrc?: string }[] = [];
---

<section class="sponsors" id="sponsors" aria-labelledby="sponsors-heading">
  <h2 id="sponsors-heading">サポーター</h2>
  {
    sponsors.length > 0 ? (
      <ul class="sponsors__list">
        {sponsors.map((s) => (
          <li>
            {s.href ? <a href={s.href}>{s.name}</a> : <span>{s.name}</span>}
          </li>
        ))}
      </ul>
    ) : null
  }
</section>

<style>
  .sponsors h2 {
    margin: 0;
    font-size: 1.1rem;
  }

  .sponsors__list {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    font-size: 0.95rem;
  }

  .sponsors__list a {
    color: var(--color-sumi-soft);
    text-decoration: none;
  }

  .sponsors__list a:hover {
    color: var(--color-kaki);
  }
</style>
