---
import SponsorStrip from './SponsorStrip.astro';
import AboutNabecco from './AboutNabecco.astro';
import SupportLinks from './SupportLinks.astro';
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <AboutNabecco />
    <SupportLinks />
    <SponsorStrip />
    <nav class="site-footer__links" aria-label="フッター">
      <a href="/rss.xml">RSS</a>
      <a href="https://github.com/lirenabe/nabecco-media/blob/main/POLICY.md">メディアポリシー</a>
      <a href="https://github.com/lirenabe/nabecco-media">GitHub</a>
      <a href="https://www.liretech.com/" target="_blank" rel="noopener noreferrer">開発・運営</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--section-gap);
    border-top: 1px solid var(--color-line);
    padding: var(--section-gap) 0 3.25rem;
    background: color-mix(in srgb, var(--color-paper-raised) 55%, var(--color-paper));
  }

  .site-footer__inner {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 0 var(--page-pad);
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.25rem;
    padding-top: 0.35rem;
    border-top: 1px solid var(--color-line);
    font-family: var(--font-body);
    font-size: 0.86rem;
    letter-spacing: 0.02em;
  }

  @media (min-width: 40rem) {
    .site-footer__links {
      flex-wrap: nowrap;
    }
  }

  .site-footer__links a {
    color: var(--color-sumi-soft);
    text-decoration: none;
  }

  .site-footer__links a:hover {
    color: var(--color-kaki);
  }
</style>
