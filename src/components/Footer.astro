---
import SponsorStrip from './SponsorStrip.astro';
import AboutNabecco from './AboutNabecco.astro';
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <AboutNabecco />
    <SponsorStrip />
    <nav class="site-footer__links" aria-label="フッター">
      <a href="/issues/">バックナンバー</a>
      <a href="https://github.com/lirenabe/nabecco-media/blob/main/POLICY.md">メディアポリシー</a>
      <a href="https://github.com/lirenabe/nabecco-media/blob/main/CONTRIBUTING.md">貢献ガイド</a>
      <a href="https://github.com/lirenabe/nabecco-media">GitHub</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--section-gap);
    border-top: 1px solid var(--color-ash);
    padding: var(--section-gap) 0 3rem;
  }

  .site-footer__inner {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 0 var(--page-pad);
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    padding-top: 0.25rem;
    font-size: 0.9rem;
  }

  .site-footer__links a {
    color: var(--color-sumi-soft);
    text-decoration: none;
  }

  .site-footer__links a:hover {
    color: var(--color-kaki);
  }
</style>
