---
/**
 * Static HTML redirect for the current latest issue URL → `/`.
 * GitHub Pages cannot emit HTTP 3xx; meta refresh + JS replace.
 * Canonical stays on the homepage (authoritative copy of latest content).
 */
const homeCanonical = new URL('/', Astro.site).href;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content="0;url=/" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={homeCanonical} />
    <meta property="og:url" content={homeCanonical} />
    <title>なべっこへ移動</title>
    <script is:inline>location.replace('/');</script>
  </head>
  <body>
    <p>
      最新号はトップページにあります。<a href="/">なべっこへ進む</a>
    </p>
  </body>
</html>
