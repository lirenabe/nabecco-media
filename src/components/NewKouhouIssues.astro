---
import { kouhouIssueHref, type KouhouEntry } from '../lib/kouhou';

interface Props {
  issues: KouhouEntry[];
}

const { issues } = Astro.props;
---

{
  issues.length > 0 && (
    <section class="new-kouhou" aria-labelledby="new-kouhou-heading">
      <h2 id="new-kouhou-heading">新着の広報</h2>
      <ul class="new-kouhou__list">
        {
          issues.map((entry) => (
            <li>
              <a href={kouhouIssueHref(entry)}>{entry.data.title}</a>
            </li>
          ))
        }
      </ul>
    </section>
  )
}

<style>
  .new-kouhou {
    margin: 2.6rem 0;
    padding: 1.35rem 0 0.35rem;
  }

  .new-kouhou h2 {
    margin: 0;
    padding-left: 0.95rem;
    border-left: var(--spine) solid var(--color-seri);
    font-family: var(--font-display);
    font-size: clamp(1.22rem, 3.2vw, 1.4rem);
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .new-kouhou__list {
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
  }

  .new-kouhou__list li {
    margin: 0;
    border-top: 1px solid var(--color-line);
  }

  .new-kouhou__list li:first-child {
    border-top: 0;
  }

  .new-kouhou__list a {
    display: block;
    padding: 0.65rem 0;
    color: var(--color-sumi);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1.55;
  }

  .new-kouhou__list a:hover {
    color: var(--color-kaki);
  }
</style>
