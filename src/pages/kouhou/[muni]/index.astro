---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  getKouhouIssues,
  kouhouIssueHref,
  kouhouIssuesForMuni,
  loadMunicipalitySources,
  type KouhouEntry,
} from '../../../lib/kouhou';

export async function getStaticPaths() {
  const sources = await loadMunicipalitySources();
  const issues = await getKouhouIssues();
  return sources.map((s) => ({
    params: { muni: s.id },
    props: {
      source: s,
      issues: kouhouIssuesForMuni(issues, s.id),
    },
  }));
}

interface Props {
  source: { id: string; name: string; listingUrl?: string };
  issues: KouhouEntry[];
}

const { source, issues } = Astro.props;
---

<BaseLayout
  title={`${source.name}の広報`}
  description={`${source.name}の公式広報要約です。確定情報は原本で確認してください。`}
>
  <div class="muni">
    <p class="muni__crumb">
      <a href="/">なべっこ</a> / <a href="/kouhou/">自治体の広報</a> / {source.name}
    </p>
    <h1>{source.name}の広報</h1>
    <p class="muni__lead">
      公式広報の要約です。確定情報は原本で確認してください。
      {
        source.listingUrl && (
          <>
            {' '}
            <a href={source.listingUrl} target="_blank" rel="noopener noreferrer">
              公式の広報ページ
            </a>
          </>
        )
      }
    </p>

    <section class="muni__section" aria-labelledby="muni-issues">
      <h2 id="muni-issues">広報の号</h2>
      {
        issues.length === 0 ? (
          <p class="muni__empty">まだ要約ページがありません。抽出後に生成します。</p>
        ) : (
          <ul class="muni__issues">
            {issues.map((issue) => (
              <li>
                <a href={kouhouIssueHref(issue)}>
                  <span>{issue.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </div>
</BaseLayout>

<style>
  .muni {
    max-width: var(--measure);
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 2.75rem) var(--page-pad) var(--section-gap);
  }

  .muni__crumb {
    margin: 0 0 1.25rem;
    font-size: 0.9rem;
    color: var(--color-sumi-soft);
  }

  .muni__crumb a {
    color: var(--color-sumi-soft);
    text-decoration: none;
  }

  .muni__crumb a:hover {
    color: var(--color-kaki);
  }

  .muni h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.45rem, 4vw, 1.85rem);
  }

  .muni__lead {
    margin: 0 0 2rem;
    line-height: 1.75;
  }

  .muni__section {
    margin: 0 0 2.25rem;
  }

  .muni__section h2 {
    margin: 0 0 0.85rem;
    font-size: 1.2rem;
  }

  .muni__empty {
    color: var(--color-sumi-soft);
  }

  .muni__issues {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .muni__issues li {
    border-top: 1px solid var(--color-ash);
    padding: 0.75rem 0;
  }

  .muni__issues li:last-child {
    border-bottom: 1px solid var(--color-ash);
  }

  .muni__issues a {
    color: var(--color-sumi);
    text-decoration: none;
  }

  .muni__issues a:hover {
    color: var(--color-kaki);
  }
</style>
