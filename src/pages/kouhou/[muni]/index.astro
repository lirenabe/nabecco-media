---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  collectEvents,
  getKouhouIssues,
  kouhouIssueHref,
  kouhouIssuesForMuni,
  loadMunicipalitySources,
  postsMentioningMunicipality,
  type KouhouEntry,
} from '../../../lib/kouhou';
import { issueListHref, getLatestPost, getPublishedPosts } from '../../../lib/posts';

export async function getStaticPaths() {
  const sources = await loadMunicipalitySources();
  const issues = await getKouhouIssues();
  return sources.map((s) => ({
    params: { muni: s.id },
    props: {
      source: s,
      issues: kouhouIssuesForMuni(issues, s.id),
    },
  }));
}

interface Props {
  source: { id: string; name: string; listingUrl?: string };
  issues: KouhouEntry[];
}

const { source, issues } = Astro.props;
const upcoming = collectEvents(issues).filter((e) => e.muniId === source.id).slice(0, 8);
const relatedPosts = await postsMentioningMunicipality(source.name);
const published = await getPublishedPosts();
const latestId = getLatestPost(published)?.id;
---

<BaseLayout
  title={`${source.name}の広報`}
  description={`${source.name}の公式広報要約と、これからの催しの案内です。確定情報は原本で確認してください。`}
>
  <div class="muni">
    <p class="muni__crumb">
      <a href="/">なべっこ</a> / <a href="/kouhou/">自治体の広報</a> / {source.name}
    </p>
    <h1>{source.name}の広報</h1>
    <p class="muni__lead">
      公式広報の機械的な要約です。確定情報は原本で確認してください。
      {
        source.listingUrl && (
          <>
            {' '}
            <a href={source.listingUrl} target="_blank" rel="noopener noreferrer">
              公式の広報ページ
            </a>
          </>
        )
      }
    </p>

    {
      upcoming.length > 0 && (
        <section class="muni__section" aria-labelledby="muni-events">
          <h2 id="muni-events">これからの催し</h2>
          <ul class="muni__events">
            {upcoming.map((ev) => (
              <li>
                <span class="muni__when">{ev.when}</span>
                <a href={ev.issueHref}>{ev.what}</a>
              </li>
            ))}
          </ul>
          <p class="muni__more">
            <a href="/events/">イベント一覧へ</a>
          </p>
        </section>
      )
    }

    <section class="muni__section" aria-labelledby="muni-issues">
      <h2 id="muni-issues">広報の号</h2>
      {
        issues.length === 0 ? (
          <p class="muni__empty">まだ要約ページがありません。抽出後に生成します。</p>
        ) : (
          <ul class="muni__issues">
            {issues.map((issue) => (
              <li>
                <a href={kouhouIssueHref(issue)}>
                  <span>{issue.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    {
      relatedPosts.length > 0 && (
        <section class="muni__section" aria-labelledby="muni-posts">
          <h2 id="muni-posts">なべっこが書いた記事</h2>
          <ul class="muni__issues">
            {relatedPosts.map((post) => (
              <li>
                <a href={issueListHref(post.id, latestId)}>{post.data.description || post.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .muni {
    max-width: var(--measure);
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 2.75rem) var(--page-pad) var(--section-gap);
  }

  .muni__crumb {
    margin: 0 0 1.25rem;
    font-size: 0.9rem;
    color: var(--color-sumi-soft);
  }

  .muni__crumb a {
    color: var(--color-sumi-soft);
    text-decoration: none;
  }

  .muni__crumb a:hover {
    color: var(--color-kaki);
  }

  .muni h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.45rem, 4vw, 1.85rem);
  }

  .muni__lead {
    margin: 0 0 2rem;
    line-height: 1.75;
  }

  .muni__section {
    margin: 0 0 2.25rem;
  }

  .muni__section h2 {
    margin: 0 0 0.85rem;
    font-size: 1.2rem;
  }

  .muni__empty {
    color: var(--color-sumi-soft);
  }

  .muni__issues,
  .muni__events {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .muni__issues li,
  .muni__events li {
    border-top: 1px solid var(--color-ash);
    padding: 0.75rem 0;
  }

  .muni__issues li:last-child,
  .muni__events li:last-child {
    border-bottom: 1px solid var(--color-ash);
  }

  .muni__issues a,
  .muni__events a {
    color: var(--color-sumi);
    text-decoration: none;
  }

  .muni__issues a:hover,
  .muni__events a:hover {
    color: var(--color-kaki);
  }

  .muni__when {
    display: block;
    margin-bottom: 0.2rem;
    color: var(--color-sumi-soft);
    font-size: 0.9rem;
  }

  .muni__more {
    margin: 0.75rem 0 0;
    font-size: 0.92rem;
  }
</style>
