---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  getKouhouIssues,
  kouhouIssueHref,
  kouhouIssuesForMuni,
  loadMunicipalitySources,
  municipalityJsonLd,
  type KouhouEntry,
} from '../../../lib/kouhou';

export async function getStaticPaths() {
  const sources = await loadMunicipalitySources();
  const issues = await getKouhouIssues();
  return sources.map((s) => ({
    params: { muni: s.id },
    props: {
      source: s,
      issues: kouhouIssuesForMuni(issues, s.id),
    },
  }));
}

interface Props {
  source: { id: string; name: string; listingUrl?: string };
  issues: KouhouEntry[];
}

const { source, issues } = Astro.props;
const pageTitle = `${source.name} 広報`;
const description = `${source.name}の公式広報の号別要約です。催し・募集・手続きなどの案内を、原本リンク付きで掲載しています。確定情報は原本で確認してください。`;
const jsonLd = municipalityJsonLd({
  site: Astro.site,
  muniId: source.id,
  muniName: source.name,
  description,
  issues,
});
---

<BaseLayout title={pageTitle} description={description}>
  <div class="muni page-shell">
    <p class="page-crumb">
      <a href="/">トップ</a> / <a href="/kouhou/">自治体の広報</a> / {source.name}
    </p>
    <h1>{pageTitle}</h1>
    <p class="muni__lead">
      公式広報の号別要約です。催し・募集・手続きなどの案内を、原本リンク付きで掲載しています。確定情報は原本で確認してください。
      {
        source.listingUrl && (
          <>
            {' '}
            <a href={source.listingUrl} target="_blank" rel="noopener noreferrer">
              公式の広報ページ
            </a>
          </>
        )
      }
    </p>

    <section class="muni__section" aria-labelledby="muni-issues">
      <h2 id="muni-issues">広報の号</h2>
      {
        issues.length === 0 ? (
          <p class="muni__empty">まだ要約ページがありません。抽出後に生成します。</p>
        ) : (
          <ul class="muni__issues">
            {issues.map((issue) => (
              <li>
                <a href={kouhouIssueHref(issue)}>
                  <span>{issue.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<style>
  .muni h1 {
    margin: 0 0 0.75rem;
    padding-left: 0.9rem;
    border-left: var(--spine) solid var(--color-kaki);
    font-size: clamp(1.55rem, 4.5vw, 1.95rem);
    letter-spacing: 0.01em;
  }

  .muni__lead {
    margin: 0 0 2.15rem;
    line-height: 1.85;
  }

  .muni__section {
    margin: 0 0 2.25rem;
  }

  .muni__section h2 {
    margin: 0 0 0.95rem;
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .muni__empty {
    color: var(--color-sumi-soft);
  }

  .muni__issues {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .muni__issues li {
    border-top: 1px solid var(--color-line);
    padding: 0.85rem 0;
  }

  .muni__issues li:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  .muni__issues a {
    color: var(--color-sumi);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .muni__issues a:hover {
    color: var(--color-kaki);
  }
</style>
