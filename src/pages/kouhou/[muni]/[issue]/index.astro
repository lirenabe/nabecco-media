---
import { render } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import {
  getKouhouIssues,
  municipalityHref,
  postsMentioningMunicipality,
  type KouhouEntry,
} from '../../../../lib/kouhou';
import { getLatestPost, getPublishedPosts, issueListHref } from '../../../../lib/posts';

export async function getStaticPaths() {
  const issues = await getKouhouIssues();
  return issues.map((entry) => ({
    params: { muni: entry.data.muniId, issue: entry.data.yearMonth },
    props: { entry },
  }));
}

interface Props {
  entry: KouhouEntry;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const relatedPosts = await postsMentioningMunicipality(entry.data.muniName);
const published = await getPublishedPosts();
const latestId = getLatestPost(published)?.id;
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="kouhou-issue">
    <p class="kouhou-issue__crumb">
      <a href="/">なべっこ</a> /
      <a href="/kouhou/">自治体の広報</a> /
      <a href={municipalityHref(entry.data.muniId)}>{entry.data.muniName}</a> /
      {entry.data.yearMonth}
    </p>
    <h1 class="kouhou-issue__title">{entry.data.title}</h1>
    <div class="prose">
      <Content />
    </div>

    {
      relatedPosts.length > 0 && (
        <section class="kouhou-issue__related" aria-labelledby="related-posts">
          <h2 id="related-posts">この号から なべっこが書いた記事</h2>
          <ul>
            {relatedPosts.map((post) => (
              <li>
                <a href={issueListHref(post.id, latestId)}>
                  {post.data.description || post.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <p class="kouhou-issue__back">
      <a href={municipalityHref(entry.data.muniId)}>{entry.data.muniName}の広報一覧へ</a>
    </p>
  </article>
</BaseLayout>

<style>
  .kouhou-issue {
    max-width: var(--measure);
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 2.5rem) var(--page-pad) var(--section-gap);
    overflow-wrap: anywhere;
    min-width: 0;
  }

  .kouhou-issue__crumb {
    margin: 0 0 1.25rem;
    font-size: 0.9rem;
    color: var(--color-sumi-soft);
  }

  .kouhou-issue__crumb a {
    color: var(--color-sumi-soft);
    text-decoration: none;
  }

  .kouhou-issue__crumb a:hover {
    color: var(--color-kaki);
  }

  .kouhou-issue__title {
    margin: 0 0 1.25rem;
    font-size: clamp(1.35rem, 4vw, 1.75rem);
    line-height: 1.3;
  }

  .kouhou-issue__related {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
  }

  .kouhou-issue__related h2 {
    margin: 0 0 0.75rem;
    font-size: 1.15rem;
  }

  .kouhou-issue__related ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .kouhou-issue__related li {
    padding: 0.55rem 0;
    border-top: 1px solid var(--color-ash);
  }

  .kouhou-issue__related li:last-child {
    border-bottom: 1px solid var(--color-ash);
  }

  .kouhou-issue__related a {
    color: var(--color-sumi);
    text-decoration: none;
  }

  .kouhou-issue__related a:hover {
    color: var(--color-kaki);
  }

  .kouhou-issue__back {
    margin: 2rem 0 0;
    font-size: 0.92rem;
  }
</style>
