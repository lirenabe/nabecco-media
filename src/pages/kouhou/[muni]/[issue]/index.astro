---
import { render } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import {
  getKouhouIssues,
  kouhouIssueJsonLd,
  kouhouIssueMetaDescription,
  municipalityHref,
  postsCitingKouhouIssue,
  yearMonthToJaIssue,
  type KouhouEntry,
} from '../../../../lib/kouhou';
import { getLatestPost, getPublishedPosts, issueListHref } from '../../../../lib/posts';

export async function getStaticPaths() {
  const issues = await getKouhouIssues();
  return issues.map((entry) => ({
    params: { muni: entry.data.muniId, issue: entry.data.yearMonth },
    props: { entry },
  }));
}

interface Props {
  entry: KouhouEntry;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const relatedPosts = await postsCitingKouhouIssue(entry);
const published = await getPublishedPosts();
const latestId = getLatestPost(published)?.id;
const description = kouhouIssueMetaDescription(entry);
const jsonLd = kouhouIssueJsonLd(entry, { site: Astro.site, description });
const issueLabel = yearMonthToJaIssue(entry.data.yearMonth) ?? entry.data.yearMonth;
---

<BaseLayout title={entry.data.title} description={description}>
  <article class="kouhou-issue page-shell">
    <p class="page-crumb">
      <a href="/">トップ</a> /
      <a href="/kouhou/">自治体の広報</a> /
      <a href={municipalityHref(entry.data.muniId)}>{entry.data.muniName}</a> /
      {issueLabel}
    </p>
    <h1 class="kouhou-issue__title">{entry.data.title}</h1>
    <div class="prose">
      <Content />
    </div>

    {
      relatedPosts.length > 0 && (
        <section class="kouhou-issue__related" aria-labelledby="related-posts">
          <h2 id="related-posts">この号が登場する記事</h2>
          <ul>
            {relatedPosts.map((post) => (
              <li>
                <a href={issueListHref(post.id, latestId)}>
                  {post.data.description || post.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <p class="kouhou-issue__back">
      <a href={municipalityHref(entry.data.muniId)}>{entry.data.muniName}の広報一覧へ</a>
    </p>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<style>
  .kouhou-issue__title {
    margin: 0 0 1.35rem;
    padding-left: 0.9rem;
    border-left: var(--spine) solid var(--color-kaki);
    font-size: clamp(1.45rem, 4.5vw, 1.9rem);
    letter-spacing: 0.01em;
    line-height: 1.4;
  }

  .kouhou-issue__related {
    margin-top: 2.75rem;
    padding-top: 1.35rem;
    border-top: 1px solid var(--color-line);
  }

  .kouhou-issue__related h2 {
    margin: 0 0 0.85rem;
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .kouhou-issue__related ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .kouhou-issue__related li {
    padding: 0.65rem 0;
    border-top: 1px solid var(--color-line);
  }

  .kouhou-issue__related li:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  .kouhou-issue__related a {
    color: var(--color-sumi);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .kouhou-issue__related a:hover {
    color: var(--color-kaki);
  }

  .kouhou-issue__back {
    margin: 2.15rem 0 0;
    font-size: 0.92rem;
  }
</style>
