---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadMunicipalitySources, municipalityHref } from '../../lib/kouhou';

const sources = await loadMunicipalitySources();
---

<BaseLayout
  title="自治体の広報要約"
  description="秋田県と全市町村の公式広報を、自治体別に要約して案内します。確定情報は原本で確認してください。"
>
  <div class="kouhou-index">
    <p class="kouhou-index__crumb"><a href="/">なべっこ</a> / 自治体の広報</p>
    <h1>自治体の広報要約</h1>
    <p class="kouhou-index__lead">
      公式広報の要約です。日程や手続きの確定情報は、必ず各自治体の原本で確認してください。
    </p>
    <ul class="kouhou-index__list">
      {
        sources.map((s) => (
          <li>
            <a href={municipalityHref(s.id)}>
              <span>{s.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .kouhou-index {
    max-width: var(--measure);
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 2.75rem) var(--page-pad) var(--section-gap);
  }

  .kouhou-index__crumb {
    margin: 0 0 1.25rem;
    font-size: 0.9rem;
    color: var(--color-sumi-soft);
  }

  .kouhou-index__crumb a {
    color: var(--color-sumi-soft);
    text-decoration: none;
  }

  .kouhou-index__crumb a:hover {
    color: var(--color-kaki);
  }

  .kouhou-index h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.45rem, 4vw, 1.85rem);
  }

  .kouhou-index__lead {
    margin: 0 0 1.75rem;
    color: var(--color-sumi);
    line-height: 1.75;
  }

  .kouhou-index__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .kouhou-index__list li {
    border-top: 1px solid var(--color-ash);
  }

  .kouhou-index__list li:last-child {
    border-bottom: 1px solid var(--color-ash);
  }

  .kouhou-index__list a {
    display: block;
    padding: 0.85rem 0;
    color: var(--color-sumi);
    text-decoration: none;
  }

  .kouhou-index__list a:hover {
    color: var(--color-kaki);
  }
</style>
