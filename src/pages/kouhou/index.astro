---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { absoluteUrl, loadMunicipalitySources, municipalityHref } from '../../lib/kouhou';

const sources = await loadMunicipalitySources();
const description =
  '秋田県と全市町村の公式広報を、自治体別に要約して案内します。確定情報は原本で確認してください。';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'トップ',
          item: absoluteUrl('/', Astro.site),
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: '自治体の広報',
          item: absoluteUrl('/kouhou/', Astro.site),
        },
      ],
    },
    {
      '@type': 'CollectionPage',
      name: '自治体の広報要約',
      description,
      url: absoluteUrl('/kouhou/', Astro.site),
      inLanguage: 'ja',
      hasPart: sources.map((s) => ({
        '@type': 'CollectionPage',
        name: `${s.name} 広報`,
        url: absoluteUrl(municipalityHref(s.id), Astro.site),
      })),
    },
  ],
};
---

<BaseLayout title="自治体の広報要約" description={description}>
  <div class="kouhou-index page-shell">
    <p class="page-crumb"><a href="/">トップ</a> / 自治体の広報</p>
    <h1>自治体の広報要約</h1>
    <p class="kouhou-index__lead">
      公式広報の要約です。日程や手続きの確定情報は、必ず各自治体の原本で確認してください。
    </p>
    <ul class="kouhou-index__list">
      {
        sources.map((s) => (
          <li>
            <a href={municipalityHref(s.id)}>
              <span>{s.name} 広報</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<style>
  .kouhou-index h1 {
    margin: 0 0 0.75rem;
    padding-left: 0.9rem;
    border-left: var(--spine) solid var(--color-kaki);
    font-size: clamp(1.55rem, 4.5vw, 1.95rem);
    letter-spacing: 0.01em;
  }

  .kouhou-index__lead {
    margin: 0 0 1.85rem;
    color: var(--color-sumi);
    line-height: 1.85;
  }

  .kouhou-index__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .kouhou-index__list li {
    border-top: 1px solid var(--color-line);
  }

  .kouhou-index__list li:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  .kouhou-index__list a {
    display: block;
    padding: 0.95rem 0;
    color: var(--color-sumi);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .kouhou-index__list a:hover {
    color: var(--color-kaki);
  }
</style>
