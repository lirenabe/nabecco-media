---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = await getCollection('posts');
const sorted = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latest = sorted[0];

if (!latest) {
  throw new Error('No posts found in content collection "posts".');
}

const { Content } = await render(latest);

const dateLabel = new Intl.DateTimeFormat('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(latest.data.pubDate);
---

<BaseLayout title="なべっこ" description={latest.data.description}>
  <article class="latest" id="latest" aria-labelledby="latest-heading">
    <header class="latest__header">
      <p class="latest__meta">
        <span>第{latest.data.vol}号</span>
        <time datetime={latest.data.pubDate.toISOString().slice(0, 10)}>{dateLabel}</time>
      </p>
      <h1 id="latest-heading">{latest.data.title}</h1>
      {
        latest.data.description && (
          <p class="latest__desc">{latest.data.description}</p>
        )
      }
    </header>
    <div class="prose">
      <Content />
    </div>
    <p class="latest__back">
      <a href="/issues/">バックナンバーを見る</a>
    </p>
  </article>
</BaseLayout>

<style>
  .latest {
    max-width: var(--measure);
    margin: 0 auto;
    padding: clamp(2rem, 6vw, 3rem) var(--page-pad) var(--section-gap);
    animation: rise 0.8s var(--ease-out) both;
  }

  .latest__header {
    margin-bottom: 1.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-ash);
  }

  .latest__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
    color: var(--color-sumi-soft);
  }

  .latest__header h1 {
    margin: 0;
    font-size: clamp(1.7rem, 3.5vw, 2.25rem);
  }

  .latest__desc {
    margin: 0.75rem 0 0;
    color: var(--color-sumi-soft);
  }

  .latest__back {
    margin: 2.5rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-ash);
    font-size: 0.95rem;
  }

  .latest__back a {
    color: var(--color-kaki-deep);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.1rem;
  }

  .latest__back a:hover {
    color: var(--color-kaki);
  }

  .prose :global(h2),
  .prose :global(h3) {
    margin: 2rem 0 0.65rem;
  }

  .prose :global(h2) {
    font-size: 1.35rem;
  }

  .prose :global(h3) {
    font-size: 1.1rem;
  }

  .prose :global(blockquote) {
    margin: 1rem 0;
    padding: 0.25rem 0 0.25rem 1rem;
    border-left: 2px solid var(--color-kaki);
    color: var(--color-sumi-soft);
    font-size: 0.95rem;
  }

  .prose :global(a) {
    color: var(--color-kaki-deep);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.6rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
