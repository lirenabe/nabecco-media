---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = await getCollection('posts');
const sorted = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latest = sorted[0];

if (!latest) {
  throw new Error('No posts found in content collection "posts".');
}

const { Content } = await render(latest);

const dateLabel = new Intl.DateTimeFormat('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(latest.data.pubDate);

const dateIso = latest.data.pubDate.toISOString().slice(0, 10);
---

<BaseLayout title="なべっこ" description={latest.data.description}>
  <article class="latest" id="latest" aria-label={`第${latest.data.vol}号`}>
    <div class="prose">
      <Content />
    </div>
    <p class="issue-date">
      <time datetime={dateIso}>{dateLabel}</time>
    </p>
  </article>
</BaseLayout>

<style>
  .latest {
    max-width: var(--measure);
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 2.5rem) var(--page-pad) var(--section-gap);
    overflow-wrap: anywhere;
    min-width: 0;
  }

  .issue-date {
    margin: 2.5rem 0 0;
    text-align: right;
    font-size: 0.88rem;
    color: var(--color-sumi-soft);
  }

  .issue-date time {
    font-variant-numeric: tabular-nums;
  }
</style>
