---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = await getCollection('posts');
const sorted = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latest = sorted[0];

if (!latest) {
  throw new Error('No posts found in content collection "posts".');
}

const { Content } = await render(latest);

const dateLabel = new Intl.DateTimeFormat('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(latest.data.pubDate);
---

<BaseLayout title="なべっこ" description={latest.data.description}>
  <article class="latest" id="latest" aria-labelledby="latest-heading">
    <h1 id="latest-heading" class="latest__meta">
      <span>第{latest.data.vol}号</span>
      <time datetime={latest.data.pubDate.toISOString().slice(0, 10)}>{dateLabel}</time>
    </h1>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .latest {
    max-width: var(--measure);
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 2.75rem) var(--page-pad) var(--section-gap);
  }

  .latest__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin: 0 0 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.35;
    color: var(--color-sumi);
  }

  .latest__meta time {
    font-weight: 600;
  }
</style>
