---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = await getCollection('posts');
const sorted = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latest = sorted[0];

if (!latest) {
  throw new Error('No posts found in content collection "posts".');
}

const { Content } = await render(latest);

const dateLabel = new Intl.DateTimeFormat('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(latest.data.pubDate);
---

<BaseLayout title="なべっこ" description={latest.data.description}>
  <section class="hero" aria-labelledby="brand">
    <div class="hero__glow" aria-hidden="true"></div>
    <p class="hero__eyebrow">秋田の週刊ダイジェスト</p>
    <h1 id="brand" class="hero__brand">なべっこ</h1>
    <p class="hero__lead">
      公式広報と街の声を、週ごとにひとつの読みものへ。火と鍋と人の輪のように、地域の情報をつなぎます。
    </p>
    <p class="hero__cta">
      <a class="hero__link" href="#latest">最新号を読む</a>
    </p>
  </section>

  <article class="latest" id="latest" aria-labelledby="latest-heading">
    <header class="latest__header">
      <p class="latest__meta">
        <span>第{latest.data.vol}号</span>
        <time datetime={latest.data.pubDate.toISOString().slice(0, 10)}>{dateLabel}</time>
      </p>
      <h2 id="latest-heading">{latest.data.title}</h2>
      {
        latest.data.description && (
          <p class="latest__desc">{latest.data.description}</p>
        )
      }
    </header>
    <div class="prose">
      <Content />
    </div>
    <p class="latest__back">
      <a href="/issues/">バックナンバーを見る</a>
    </p>
  </article>
</BaseLayout>

<style>
  .hero {
    position: relative;
    max-width: 72rem;
    margin: 0 auto;
    padding: clamp(4rem, 14vw, 8rem) var(--page-pad) clamp(3rem, 8vw, 5rem);
    overflow: hidden;
  }

  .hero__glow {
    position: absolute;
    inset: 10% auto auto 50%;
    width: min(42rem, 90vw);
    height: min(42rem, 90vw);
    transform: translateX(-50%);
    background:
      radial-gradient(circle at 50% 40%, rgba(196, 90, 46, 0.22), transparent 58%),
      radial-gradient(circle at 35% 65%, rgba(28, 25, 23, 0.08), transparent 50%);
    pointer-events: none;
    animation: ember 4.5s var(--ease-out) both;
  }

  .hero__eyebrow {
    position: relative;
    margin: 0 0 0.75rem;
    font-size: 0.92rem;
    letter-spacing: 0.18em;
    color: var(--color-sumi-soft);
    animation: rise 0.8s var(--ease-out) both;
  }

  .hero__brand {
    position: relative;
    margin: 0;
    font-size: clamp(3.4rem, 12vw, 6.5rem);
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.05;
    animation: rise 0.9s var(--ease-out) 0.08s both;
  }

  .hero__lead {
    position: relative;
    max-width: 28rem;
    margin: 1.25rem 0 0;
    font-size: clamp(1.05rem, 2.2vw, 1.2rem);
    color: var(--color-sumi-soft);
    animation: rise 0.9s var(--ease-out) 0.16s both;
  }

  .hero__cta {
    position: relative;
    margin: 1.75rem 0 0;
    animation: rise 0.9s var(--ease-out) 0.24s both;
  }

  .hero__link {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: 0.06em;
    color: var(--color-kaki-deep);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.15rem;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .hero__link:hover {
    color: var(--color-kaki);
  }

  .latest {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 0 var(--page-pad) var(--section-gap);
    animation: rise 0.9s var(--ease-out) 0.2s both;
  }

  .latest__header {
    margin-bottom: 1.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-ash);
  }

  .latest__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
    color: var(--color-sumi-soft);
  }

  .latest__header h2 {
    margin: 0;
    font-size: clamp(1.6rem, 3vw, 2.1rem);
  }

  .latest__desc {
    margin: 0.75rem 0 0;
    color: var(--color-sumi-soft);
  }

  .latest__back {
    margin: 2.5rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-ash);
    font-size: 0.95rem;
  }

  .latest__back a {
    color: var(--color-kaki-deep);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.1rem;
  }

  .latest__back a:hover {
    color: var(--color-kaki);
  }

  .prose :global(h2),
  .prose :global(h3) {
    margin: 2rem 0 0.65rem;
  }

  .prose :global(h2) {
    font-size: 1.35rem;
  }

  .prose :global(h3) {
    font-size: 1.1rem;
  }

  .prose :global(blockquote) {
    margin: 1rem 0;
    padding: 0.25rem 0 0.25rem 1rem;
    border-left: 2px solid var(--color-kaki);
    color: var(--color-sumi-soft);
    font-size: 0.95rem;
  }

  .prose :global(a) {
    color: var(--color-kaki-deep);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes ember {
    from {
      opacity: 0;
      transform: translateX(-50%) scale(0.92);
    }
    to {
      opacity: 1;
      transform: translateX(-50%) scale(1);
    }
  }
</style>
