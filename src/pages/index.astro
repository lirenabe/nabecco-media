---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = await getCollection('posts');
const sorted = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latest = sorted[0];

if (!latest) {
  throw new Error('No posts found in content collection "posts".');
}

const { Content } = await render(latest);

const dateLabel = new Intl.DateTimeFormat('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(latest.data.pubDate);
---

<BaseLayout title="なべっこ" description={latest.data.description}>
  <article class="latest" id="latest" aria-label={latest.data.title}>
    <p class="latest__meta">
      <span>第{latest.data.vol}号</span>
      <time datetime={latest.data.pubDate.toISOString().slice(0, 10)}>{dateLabel}</time>
    </p>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .latest {
    max-width: var(--measure);
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 2.75rem) var(--page-pad) var(--section-gap);
  }

  .latest__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin: 0 0 1rem;
    font-size: 0.9rem;
    color: var(--color-sumi-soft);
  }
</style>
