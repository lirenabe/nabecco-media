---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewKouhouIssues from '../components/NewKouhouIssues.astro';
import {
  getKouhouIssues,
  listNewKouhouIssues,
  previousIssuePubDate,
} from '../lib/kouhou';
import {
  getPublishedPosts,
  issueShareTitle,
  resolveIssueOgImage,
  sortPostsByDateDesc,
} from '../lib/posts';
import { renderPostMarkdown, splitPostBodyAroundEvents } from '../lib/render-post-markdown';

const sorted = sortPostsByDateDesc(await getPublishedPosts());
const latest = sorted[0];
const allKouhou = await getKouhouIssues();
const newKouhou = latest
  ? listNewKouhouIssues(allKouhou, previousIssuePubDate(sorted, latest.data.pubDate))
  : [];

const siteDescription =
  '秋田県の公式広報と街の声を週ごとに要約する地域メディア、なべっこ。';

let htmlBefore = '';
let htmlAfter = '';
let hasEventsHeading = false;
let dateLabel = '';
let dateIso = '';

if (latest) {
  const parts = splitPostBodyAroundEvents(latest.body);
  hasEventsHeading = parts.hasEventsHeading;
  htmlBefore = await renderPostMarkdown(parts.before);
  htmlAfter = parts.hasEventsHeading ? await renderPostMarkdown(parts.after) : '';
  dateLabel = new Intl.DateTimeFormat('ja-JP', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(latest.data.pubDate);
  dateIso = latest.data.pubDate.toISOString().slice(0, 10);
}

const pageTitle = latest ? issueShareTitle(latest.data) : 'なべっこ';
const pageDescription = latest?.data.description ?? siteDescription;
const pageImage = latest ? resolveIssueOgImage(latest.data, latest.body) : '/og.png';
---

<BaseLayout title={pageTitle} description={pageDescription} image={pageImage}>
  {
    latest ? (
      <article class="latest" id="latest" aria-label={`第${latest.data.vol}号`}>
        <div class="prose" set:html={htmlBefore} />
        {hasEventsHeading ? <NewKouhouIssues issues={newKouhou} /> : null}
        {hasEventsHeading ? <div class="prose" set:html={htmlAfter} /> : null}
        {!hasEventsHeading ? <NewKouhouIssues issues={newKouhou} /> : null}
        <p class="issue-date">
          発行日 <time datetime={dateIso}>{dateLabel}</time>
        </p>
      </article>
    ) : (
      <section class="latest latest--empty" id="latest" aria-label="最新号">
        <h1 class="latest__empty-title">なべっこ</h1>
        <p class="latest__empty-lead">
          現在、公開中の号はありません。確認が終わった号から順に掲載します。
        </p>
      </section>
    )
  }
</BaseLayout>

<style>
  .latest {
    max-width: var(--measure);
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 2.5rem) var(--page-pad) var(--section-gap);
    overflow-wrap: anywhere;
    min-width: 0;
  }

  .latest--empty {
    padding-top: clamp(2.5rem, 8vw, 4rem);
  }

  .latest__empty-title {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .latest__empty-lead {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-sumi);
  }

  .issue-date {
    margin: 2.5rem 0 0;
    text-align: right;
    font-size: 0.88rem;
    color: var(--color-sumi-soft);
  }

  .issue-date time {
    font-variant-numeric: tabular-nums;
  }
</style>
