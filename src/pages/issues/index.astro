---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackIssueList from '../../components/BackIssueList.astro';
import {
  getLatestPost,
  getPublishedPosts,
  issueListHref,
  sortPostsByDateDesc,
} from '../../lib/posts';

const sorted = sortPostsByDateDesc(await getPublishedPosts());
const latestId = getLatestPost(sorted)?.id;

// Same set as the header menu: include the latest published issue.
const issues = sorted.map((post) => ({
  id: post.id,
  title: post.data.title,
  pubDate: post.data.pubDate,
  href: issueListHref(post.id, latestId),
}));
---

<BaseLayout title="バックナンバー" description="なべっこに掲載した号の一覧です。最新号はトップページでも読めます。">
  <div class="issues-page">
    <p class="issues-page__crumb"><a href="/">なべっこ</a> / バックナンバー</p>
    <BackIssueList issues={issues} />
  </div>
</BaseLayout>

<style>
  .issues-page {
    max-width: var(--measure);
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 2.75rem) 0 var(--section-gap);
  }

  .issues-page__crumb {
    margin: 0 0 1.5rem;
    padding: 0 var(--page-pad);
    font-size: 0.9rem;
    color: var(--color-sumi-soft);
  }

  .issues-page__crumb a {
    color: var(--color-sumi-soft);
    text-decoration: none;
  }

  .issues-page__crumb a:hover {
    color: var(--color-kaki);
  }
</style>
