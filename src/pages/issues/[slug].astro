---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateLabel = new Intl.DateTimeFormat('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(post.data.pubDate);

const dateIso = post.data.pubDate.toISOString().slice(0, 10);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="issue" aria-label={`第${post.data.vol}号`}>
    <p class="issue__crumb">
      <a href="/">なべっこ</a> / <a href="/issues/">バックナンバー</a>
    </p>
    <div class="prose">
      <Content />
    </div>
    <p class="issue-date">
      発行日 <time datetime={dateIso}>{dateLabel}</time>
    </p>
  </article>
</BaseLayout>

<style>
  .issue {
    max-width: var(--measure);
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 2.5rem) var(--page-pad) var(--section-gap);
    overflow-wrap: anywhere;
    min-width: 0;
  }

  .issue__crumb {
    margin: 0 0 1.25rem;
    font-size: 0.9rem;
    color: var(--color-sumi-soft);
  }

  .issue__crumb a {
    color: var(--color-sumi-soft);
    text-decoration: none;
  }

  .issue__crumb a:hover {
    color: var(--color-kaki);
  }

  .issue-date {
    margin: 2.5rem 0 0;
    text-align: right;
    font-size: 0.88rem;
    color: var(--color-sumi-soft);
  }

  .issue-date time {
    font-variant-numeric: tabular-nums;
  }
</style>
