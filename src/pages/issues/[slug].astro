---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewKouhouIssues from '../../components/NewKouhouIssues.astro';
import {
  getKouhouIssues,
  listNewKouhouIssues,
  previousIssuePubDate,
  type KouhouEntry,
} from '../../lib/kouhou';
import { issueArticleJsonLd } from '../../lib/issue-seo';
import {
  getPublishedPosts,
  issueShareTitle,
  resolveIssueOgImage,
  type PostEntry,
} from '../../lib/posts';
import { renderPostMarkdown, splitPostBodyAroundEvents } from '../../lib/render-post-markdown';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const kouhou = await getKouhouIssues();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      newKouhou: listNewKouhouIssues(kouhou, previousIssuePubDate(posts, post.data.pubDate)),
    },
  }));
}

interface Props {
  post: PostEntry;
  newKouhou: KouhouEntry[];
}

const { post, newKouhou } = Astro.props;

const parts = splitPostBodyAroundEvents(post.body);
const hasEventsHeading = parts.hasEventsHeading;
const htmlBefore = await renderPostMarkdown(parts.before);
const htmlAfter = parts.hasEventsHeading ? await renderPostMarkdown(parts.after) : '';
const dateLabel = new Intl.DateTimeFormat('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(post.data.pubDate);
const dateIso = post.data.pubDate.toISOString().slice(0, 10);
const pageTitle = issueShareTitle(post.data);
const pageImage = resolveIssueOgImage(post.data, post.body);
const pathname = `/issues/${post.id}/`;
const jsonLd = issueArticleJsonLd(
  {
    id: post.id,
    title: pageTitle,
    description: post.data.description,
    pubDate: post.data.pubDate,
    imagePath: pageImage,
    pathname,
    includeBackIssuesCrumb: true,
  },
  Astro.site,
);
---

<BaseLayout title={pageTitle} description={post.data.description} image={pageImage}>
  <article class="issue" aria-label={`第${post.data.vol}号`}>
    <p class="issue__crumb">
      <a href="/">トップ</a> / <a href="/issues/">バックナンバー</a>
    </p>
    <div class="prose" set:html={htmlBefore} />
    {hasEventsHeading ? <NewKouhouIssues issues={newKouhou} /> : null}
    {hasEventsHeading ? <div class="prose" set:html={htmlAfter} /> : null}
    {!hasEventsHeading ? <NewKouhouIssues issues={newKouhou} /> : null}
    <p class="issue-date">
      発行日 <time datetime={dateIso}>{dateLabel}</time>
    </p>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<style>
  .issue {
    max-width: var(--measure);
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 2.5rem) var(--page-pad) var(--section-gap);
    overflow-wrap: anywhere;
    min-width: 0;
  }

  .issue__crumb {
    margin: 0 0 1.25rem;
    font-size: 0.9rem;
    color: var(--color-sumi-soft);
  }

  .issue__crumb a {
    color: var(--color-sumi-soft);
    text-decoration: none;
  }

  .issue__crumb a:hover {
    color: var(--color-kaki);
  }

  .issue-date {
    margin: 2.5rem 0 0;
    text-align: right;
    font-size: 0.88rem;
    color: var(--color-sumi-soft);
  }

  .issue-date time {
    font-variant-numeric: tabular-nums;
  }
</style>
