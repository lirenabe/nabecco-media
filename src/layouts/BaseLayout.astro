---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SponsorStrip from '../components/SponsorStrip.astro';
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
  showSponsors?: boolean;
}

const {
  title,
  description = '秋田県内の公式広報と街の声を週ごとに要約するオープンソース地域メディア、なべっこ。',
  showSponsors = true,
} = Astro.props;

const pageTitle = title === 'なべっこ' ? title : `${title} | なべっこ`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;600;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    {showSponsors && <SponsorStrip />}
    <Footer />
  </body>
</html>

<style is:global>
  main {
    display: block;
  }
</style>
