{
  "name": "nabecco-media",
  "description": "なべっこ — 秋田の公式広報と街の声を週ごとに読み物へまとめるオープンソース地域メディア（nabecco.media）",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check:textlint": "node scripts/check-textlint.mjs",
    "check:design": "node scripts/check-design.mjs",
    "check:citations": "node scripts/check-citations.mjs",
    "check:links:md": "node scripts/check-links.mjs md",
    "check:links:site": "node scripts/check-links.mjs site",
    "check:links": "node scripts/check-links.mjs all",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:fast": "npm run check:textlint && npm run check:design && npm run check:citations && npm run check:links:md",
    "check": "npm run build && npm run check:fast && npm run check:links:site && npm run check:a11y && npm run check:seo",
    "factcheck": "node scripts/factcheck.mjs",
    "fetch:kouhou": "node scripts/fetch-kouhou.mjs",
    "extract:kouhou": "node scripts/extract-kouhou.mjs",
    "draft": "node scripts/draft-issue.mjs",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "**/*.{md,mdx}": [
      "textlint"
    ],
    "src/content/posts/*.md": [
      "node scripts/check-citations.mjs"
    ],
    "src/**/*.{css,astro}": [
      "node scripts/check-design.mjs"
    ]
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "linkinator": "^8.1.0",
    "lint-staged": "^17.6.0",
    "markdown-link-check": "^3.15.0",
    "playwright": "^1.64.1",
    "simple-git-hooks": "^2.14.0",
    "textlint": "^15.8.0",
    "textlint-filter-rule-comments": "^1.3.0",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2"
  }
}
